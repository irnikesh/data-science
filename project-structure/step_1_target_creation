# create date partitioning from start date to end date
date_sequence = F.sequence(F.col("start_date"), F.col("end_date"), F.expr(DATE_PARTITION_INTERVAL))

churn_data_w_labels_full = (
    churn_data_raw
    .withColumn("date_partition", F.explode(date_sequence))
    .withColumn(f"{TARGET_NAME}", F.when(F.datediff(F.col("churned_at"), F.col("date_partition")) < DAYS_BEFORE_CHURN, 1).otherwise(0))
    .drop("rundate_minus_days_before_churn")
)

# COMMAND ----------

# remove orgs with missing data for now
missing_date_orgs = (
    churn_data_w_labels_full.alias("o")
    .join(daily_arr.alias("m"), 
          ((F.col("o.id") == F.col("m.id")) & (F.col("o.date_partition") == F.col("m.date_partition"))),"left")
    .select(F.col("o.id").alias("id"), F.col("o.date_partition").alias("date_partition"), F.col("m.date_partition").alias("dp2"))
    .filter(F.col("dp2").isNull()).select("id").distinct()
)

churn_data_w_labels_full = churn_data_w_labels_full.join(missing_date_orgs, "id", "left_anti")


