# Read back saved data
churn_data_w_labels_full = spark.read.parquet(churn_data_w_labels_full_path)

# COMMAND ----------

# Split data on train & test datasets using OOS split

split_ratio = [0.8, 0.2]
train_keys, test_keys = (
    churn_data_w_labels_full
    .select("id")
    .distinct()
    .randomSplit(weights=split_ratio, seed=23)
)

# TODO: change to OOS+OOT. For now it is OOS. Problem: with OOT entries are filtered out.

# COMMAND ----------

ids_train_test_split = (
    train_keys
    .select('id').distinct()
    .withColumn('is_train', F.lit(True))
    .unionByName(
        test_keys
        .select('id').distinct()
        .withColumn('is_train', F.lit(False))
        )
)

ids_train_test_split.count()

# COMMAND ----------

# Write Final Dataset
ids_train_test_split.repartition(64).write.parquet(ids_train_test_split_path, mode='overwrite')

