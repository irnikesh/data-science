from pyspark.sql import functions as F
from pyspark.sql.window import Window


def detect_spikes(df, board_id_col, date_col, feature_count_col, window_size):
    """
    Detect spikes in the feature count column based on differences
    compared to a certain window in the past.

    Args:
    - df: DataFrame containing the data
    - board_id_col: Name of the column containing board IDs
    - date_col: Name of the column containing dates
    - feature_count_col: Name of the column containing feature counts
    - window_size: Size of the window to compare differences

    Returns:
    - DataFrame with a new column 'Spike' indicating spikes
    """

    window_spec = Window.partitionBy(board_id_col).orderBy(date_col)

    df = df.withColumn('diff', F.col(feature_count_col) - F.lag(F.col(feature_count_col)).over(window_spec)).fillna({'diff':0})
    
    window_spec = Window.partitionBy(board_id_col).rowsBetween(-window_size, Window.currentRow)

    df = (
       df
       .withColumn(f'{feature_count_col}_avg_{window_size}', F.mean('diff').over(window_spec))
       .withColumn(f'{feature_count_col}_stddev_{window_size}', F.stddev('diff').over(window_spec))
       .withColumn(f'{feature_count_col}_coef_var_{window_size}', F.col(f'{feature_count_col}_stddev_{window_size}') / F.col(f'{feature_count_col}_avg_{window_size}'))
       .drop('diff')
    )
    
    return df
