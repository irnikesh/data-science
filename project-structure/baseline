    y_pred_proba = test_df['exported_boards_ratio'] #NB! it's not a real probability, it's just a ratio that we use for a baseline rule
    y_pred = test_df['is_churned_next_45_days_prediction']
    y_test = test_df['is_churned_next_45_days']

    recall,roc_auc,precision =[],[],[]

    recall.append(round(recall_score(y_test, y_pred),4))
    roc_auc.append(round(roc_auc_score(y_test, y_pred_proba),4))
    precision.append(round(precision_score(y_test, y_pred),4))

    result_df = pd.DataFrame({'Recall':recall, 'Roc_Auc':roc_auc, 'Precision':precision}, index=['baseline'])
